# Copy to `.dev.vars` for local development (`.dev.vars` is git-ignored).
# In production these are set in the Webflow Cloud UI, never in the repo.

# Shared household password for the login gate.
NUMO_PASSWORD=

# Optional. Dedicated secret for signing the session cookie.
# If unset, the signing key is derived from NUMO_PASSWORD — which means every
# session is invalidated when the password changes. Set this to keep sessions
# alive across password rotation.
NUMO_SESSION_SECRET=

# Optional. Claude API key for the AI layer (column mapping, category
# suggestions, free-text import instructions). Without it numo works fine and
# the AI features stay hidden.
ANTHROPIC_API_KEY=
