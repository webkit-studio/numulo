# Copy to `.dev.vars` for local development (`.dev.vars` is git-ignored).
# In production these are set in the Webflow Cloud UI, never in the repo.

# Optional. Secret for signing the session cookie. If unset, numo generates one
# on first use and keeps it in the database, so nothing has to be configured —
# set it explicitly if you want sessions to survive a database reset.
NUMO_SESSION_SECRET=

# Optional. Resend API key for the "set / forgotten password" e-mail link.
# Without it the link cannot be sent and the app says so instead of pretending.
RESEND_API_KEY=
NUMO_MAIL_FROM="numo <numo@example.com>"

# Optional. Claude API key for the AI layer (column mapping, category
# suggestions, free-text import instructions). Without it numo works fine and
# the AI features stay hidden.
ANTHROPIC_API_KEY=

# Optional, but required for public sign-up. Cloudflare Turnstile keys.
# Without both, registration stays closed rather than silently unprotected.
# Cloudflare's always-passes test keys, for local development only:
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
