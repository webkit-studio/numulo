# Veřejný klíč je v prohlížeči v pořádku: sám o sobě nedává nic, protože každá
# tabulka je za row-level security podle členství v domácnosti.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Volitelné. Bez něj import funguje dál — jen si sloupce výpisu odvodí sám,
# bez pomoci modelu. Model nikdy nevidí data, jen nadpisy sloupců.
# ANTHROPIC_API_KEY=sk-ant-...
